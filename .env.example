OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# Per model request, not the whole multi-agent workflow. One SDK retry is allowed.
OPENAI_TIMEOUT_SECONDS=180
# CLI only: python -m src.main fetches GitHub directly.
# The HTTP API receives code from the App and does not need this credential.
GITHUB_TOKEN=
GITHUB_OWNER=sriram-senthilkr
GITHUB_REPO=mock-website
GITHUB_PR_NUMBER=
GITHUB_MERGE_COMMIT_SHA=
# Optional single-document selection. Leave blank to use all input runbooks.
RUNBOOK_PATH=
# Optional: defaults to a sibling .updated.docx file.
RUNBOOK_OUTPUT_PATH=

# HTTP API configuration. Same shared token as github-app/BACKEND_TOKEN.
BACKEND_TOKEN=
SOURCE_REPOSITORY=sriram-senthilkr/mock-website
# SQLite database, receipts, immutable input snapshots, and approved outputs.
BACKEND_DATA_DIR=.data
# API outputs: BACKEND_DATA_DIR/<analysis_id>/outputs/<runbook-name>.docx
# Empty QDRANT_URL uses embedded Qdrant under BACKEND_DATA_DIR/qdrant.
QDRANT_URL=

# Backend runbook selection for the CLI and API; defaults to all input runbooks.
# Optional JSON array, e.g. ["test_data/input/Orders.docx","test_data/input/Payments.docx"]
RUNBOOK_PATHS=
RUNBOOK_OUTPUT_DIR=test_data/output

# Zero-shot classifier that scores whether each runbook issue is needed.
# Scores are shown at approval; no issue is dropped.
NECESSITY_MODEL=MoritzLaurer/deberta-v3-large-zeroshot-v2.0
